generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUBMITTER
  REP
  MANAGER
  ADMIN
}

enum LiabilityStatus {
  NEEDS_REVIEW
  ACKNOWLEDGED
  MANAGER_ACKNOWLEDGED
}

enum Region {
  EAST
  WEST
  CENTRAL
}

enum FeedbackType {
  NO_QA_LIABILITIES
  COACHING_OPPORTUNITY
  LIABILITY
}

enum RecordingSource {
  ZRA
  ZOOM
  HUBSPOT
  UPLOAD
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(REP)
  hireDate      DateTime?

  managerId String?
  manager   User?   @relation("ManagerReps", fields: [managerId], references: [id])
  reps      User[]  @relation("ManagerReps")

  accounts      Account[]
  sessions      Session[]
  liabilities   Liability[]        @relation("RepLiabilities")
  submitted     Liability[]        @relation("SubmitterLiabilities")
  comments      LiabilityComment[]
  notifications Notification[]

  repReviews       QAReview[] @relation("RepQAReviews")
  submittedReviews QAReview[] @relation("SubmitterQAReviews")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Liability {
  id                    String          @id @default(cuid())
  repId                 String
  submitterId           String
  customerName          String
  callDate              DateTime
  callLength            String?
  callLink              String?
  liabilityReason       String
  notes                 String
  region                Region
  imageUrls             String[]        @default([])
  status                LiabilityStatus @default(NEEDS_REVIEW)
  acknowledgedAt        DateTime?
  managerAcknowledgedAt DateTime?

  rep       User @relation("RepLiabilities", fields: [repId], references: [id])
  submitter User @relation("SubmitterLiabilities", fields: [submitterId], references: [id])

  comments      LiabilityComment[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommentType {
  MANAGER
  SUBMITTER
}

model LiabilityComment {
  id          String      @id @default(cuid())
  liabilityId String
  authorId    String
  type        CommentType
  body        String
  imageUrls   String[]    @default([])

  liability Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id          String  @id @default(cuid())
  userId      String
  liabilityId String?
  qaReviewId  String?
  message     String
  read        Boolean @default(false)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  liability Liability? @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  qaReview  QAReview?  @relation(fields: [qaReviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ── Lookup tables ────────────────────────────────────────────────────────────

model CallType {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  reviews   QAReview[]
  createdAt DateTime   @default(now())
}

model Playlist {
  id        String             @id @default(cuid())
  name      String             @unique
  active    Boolean            @default(true)
  reviews   QAReviewPlaylist[]
  createdAt DateTime           @default(now())
}

model Product {
  id        String            @id @default(cuid())
  name      String            @unique
  active    Boolean           @default(true)
  reviews   QAReviewProduct[]
  createdAt DateTime          @default(now())
}

// ── QA Review ────────────────────────────────────────────────────────────────

model QAReview {
  id              String          @id @default(cuid())
  repId           String
  submitterId     String
  callDate        DateTime
  callTypeId      String
  recordingUrl    String?
  recordingSource RecordingSource?
  sourceCallId    String?          // external call ID (e.g. ZRA conversation ID)
  sourceSystem    String?          // which system the call came from (e.g. "ZRA")
  feedbackTypes   FeedbackType[]
  liabilityReason String?
  region          Region?
  notes           String
  imageUrls       String[]        @default([])

  rep         User              @relation("RepQAReviews", fields: [repId], references: [id])
  submitter   User              @relation("SubmitterQAReviews", fields: [submitterId], references: [id])
  callType    CallType          @relation(fields: [callTypeId], references: [id])
  playlists   QAReviewPlaylist[]
  products    QAReviewProduct[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QAReviewPlaylist {
  reviewId   String
  playlistId String
  review     QAReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [id])

  @@id([reviewId, playlistId])
}

model QAReviewProduct {
  reviewId  String
  productId String
  review    QAReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@id([reviewId, productId])
}
