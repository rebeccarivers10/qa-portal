generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUBMITTER
  REP
  MANAGER
  ADMIN
}

enum LiabilityStatus {
  PENDING
  ACKNOWLEDGED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(REP)

  managerId String?
  manager   User?   @relation("ManagerReps", fields: [managerId], references: [id])
  reps      User[]  @relation("ManagerReps")

  accounts      Account[]
  sessions      Session[]
  liabilities   Liability[]      @relation("RepLiabilities")
  submitted     Liability[]      @relation("SubmitterLiabilities")
  comments      LiabilityComment[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Liability {
  id             String          @id @default(cuid())
  repId          String
  submitterId    String
  contactDate    DateTime
  notes          String
  imageUrls      String[]        @default([])
  status         LiabilityStatus @default(PENDING)
  acknowledgedAt DateTime?

  rep       User @relation("RepLiabilities", fields: [repId], references: [id])
  submitter User @relation("SubmitterLiabilities", fields: [submitterId], references: [id])

  comments      LiabilityComment[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommentType {
  REVIEWEE
  MANAGER
  SUBMITTER
}

model LiabilityComment {
  id          String      @id @default(cuid())
  liabilityId String
  authorId    String
  type        CommentType
  body        String
  imageUrls   String[]    @default([])

  liability Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id          String  @id @default(cuid())
  userId      String
  liabilityId String
  message     String
  read        Boolean @default(false)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  liability Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
